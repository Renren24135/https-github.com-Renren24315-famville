APP_NAME="Famville Koronadal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain-or-subdomain.example.com
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel MySQL databases/users are usually prefixed with your cPanel
# username, e.g. cpaneluser_famville / cpaneluser_famville_user
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_famville
DB_USERNAME=cpaneluser_famville
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Brevo (Sendinblue) transactional SMTP — 300 emails/day free.
# Get these from Brevo: Settings -> SMTP & API -> SMTP tab.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain-or-subdomain.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Only set this if your host puts the app behind a proxy/CDN (e.g.
# Cloudflare). Leave blank on typical shared cPanel hosting.
APP_TRUSTED_PROXIES=
