APP_NAME="Famville Koronadal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Railway gives you this once you deploy — a *.up.railway.app URL,
# or your own domain if you attach one later.
APP_URL=https://your-app-name.up.railway.app
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Add a MySQL service in the Railway project first, then reference its
# variables here using Railway's ${{ServiceName.VAR}} syntax so they stay
# in sync automatically — set these as Railway environment variables, not
# by editing a file on disk. Assuming the MySQL service is named "MySQL":
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Brevo (Sendinblue) transactional SMTP — 300 emails/day free.
# Get these from Brevo: Settings -> SMTP & API -> SMTP tab.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-app-name.up.railway.app"
MAIL_FROM_NAME="${APP_NAME}"

# Railway terminates HTTPS at its edge and forwards requests over HTTP
# internally — trust its proxy so the app's own HTTPS redirect and
# secure-cookie logic see the request as HTTPS instead of looping.
APP_TRUSTED_PROXIES=*

# From PayMongo's dashboard (Developers -> API Keys, in LIVE mode) and
# the live webhook you create against this app's real production URL
# once it's deployed (see docs — a webhook can't be registered against
# a URL that doesn't exist yet).
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
